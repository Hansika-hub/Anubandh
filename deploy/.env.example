# Anubandh compose environment. Copy to deploy/.env (git-ignored) and edit.
# Names are frozen in BUILD.md section 3. Owner: M3.

# --- data plane ---
POSTGRES_USER=anubandh
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=anubandh
PG_DSN=postgres://anubandh:change-me-local-only@postgres:5432/anubandh?sslmode=disable
KAFKA_BROKERS=redpanda:9092

# --- service URLs (compose service name = DNS name) ---
GATEWAY_URL=http://gateway:8080
INGEST_URL=http://ingest-api:8081
FORECAST_URL=http://forecast:8090
SIM_BANK_URL=http://sim-bank:8101
SIM_GRN_URL=http://sim-grn:8102
SIM_GST_URL=http://sim-gst:8103
SIM_UDYAM_URL=http://sim-udyam:8104

# --- ingest webhook secrets: one per X-Source. Generate with: openssl rand -hex 32 ---
HMAC_SECRET_WAREHOUSE=dev-only-warehouse-secret-change-me
HMAC_SECRET_ERP=dev-only-erp-secret-change-me
HMAC_SECRET_GST=dev-only-gst-secret-change-me
HMAC_SECRET_BANK=dev-only-bank-secret-change-me

# --- gateway <-> workers ---
# Shared secret for /internal/v1/* (never expose that path publicly).
INTERNAL_TOKEN=dev-only-internal-token-change-me
# true = gateway uses its in-memory chaincode (no Fabric network needed). false = real network.
FABRIC_MOCK=true
# true = workers use a stubbed gateway that always returns 200 (BUILD.md 14.4).
GATEWAY_MOCK=false

# --- Fabric / Drunix ---
FABRIC_CHANNEL=anubandh-ch
FABRIC_CC_NAME=deal
# Directory produced by `make network` (see network/README.md).
FABRIC_CRYPTO_DIR=../network/crypto

# --- ingest tuning ---
INGEST_RATE_RPS=50
INGEST_RATE_BURST=100
WORKER_MAX_ATTEMPTS=5
WORKER_REQUEUE_DELAY=2s
